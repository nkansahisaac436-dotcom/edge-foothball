# ==========================================
# Matchday Edge - Configuration & API Keys
# ==========================================

# Port for the backend server
PORT=5000
NODE_ENV=development

# Football Data Provider Choice:
# Options: 'auto' | 'api-football' | 'football-data-org' | 'mock'
# If set to 'auto', it uses API_FOOTBALL_KEY or FOOTBALL_DATA_ORG_KEY if present,
# otherwise falls back automatically to the built-in rich Mock provider.
FOOTBALL_DATA_PROVIDER=auto

# Option 1: API-Football (api-sports.io / RapidAPI)
# Get a free tier key (100 req/day) from: https://dashboard.api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here

# Option 2: Football-Data.org
# Get a free tier token from: https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=your_football_data_org_key_here

# Prediction Model Configurations
# Default weighting between model Poisson probability and market implied probability
DEFAULT_MODEL_WEIGHT=0.70

# Dixon-Coles low score correlation parameter (typically -0.11)
DIXON_COLES_RHO=-0.11

# Cache TTL overrides (in milliseconds, optional)
# TTL_FIXTURES_MS=3600000
# TTL_TEAM_STATS_MS=86400000
