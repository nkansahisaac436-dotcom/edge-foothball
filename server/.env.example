# Port for the backend server
PORT=5000
NODE_ENV=development

# Football Data Provider Choice: 'auto' | 'api-football' | 'football-data-org' | 'mock'
FOOTBALL_DATA_PROVIDER=auto

# Free API Keys (Leave blank to use the built-in rich Mock provider for offline development)
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=

# Model weight (70% model, 30% market)
DEFAULT_MODEL_WEIGHT=0.70
DIXON_COLES_RHO=-0.11
